# Database
# Local Docker Postgres:
DATABASE_URL="postgresql://imtiaz:imtiaz@localhost:5432/imtiaz_mart?schema=public"
DIRECT_URL="postgresql://imtiaz:imtiaz@localhost:5432/imtiaz_mart?schema=public"

# Supabase (replace [PASSWORD] and [REGION] from Project Settings → Database):
# DATABASE_URL="postgresql://postgres.lrkotacbbtcpteqinpce:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.lrkotacbbtcpteqinpce:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch (optional — catalog search falls back to PostgreSQL)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="atvoo-products"

# Payments (optional — sandbox capture is used when keys are absent)
STRIPE_SECRET_KEY=""
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
PLATFORM_FEE_RATE="0.10"

# API
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Auth (generate secure values for production / Vercel)
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SOCIAL_ENCRYPTION_KEY="generate-a-random-32-character-value"

# Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ATVOO"

# Production / Vercel (storefront project Root Directory: repo root or `apps`)
# APP_URL="https://imtiaz-mart.vercel.app"
# API_URL="https://imtiaz-mart-api.vercel.app"
# CORS_ORIGIN="https://imtiaz-mart.vercel.app"
# NEXT_PUBLIC_APP_URL="https://imtiaz-mart.vercel.app"
# NEXT_PUBLIC_API_URL="https://imtiaz-mart-api.vercel.app/api/v1"
# Do not commit real JWT / database passwords. Set them in the Vercel dashboard.
# Google OAuth (customers and vendors)
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI:     http://localhost:3000/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
