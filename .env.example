# Database
DATABASE_URL="postgresql://imtiaz:imtiaz@localhost:5432/imtiaz_mart?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch (optional — catalog search falls back to PostgreSQL)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="atvoo-products"

# Payments (optional — sandbox capture is used when keys are absent)
STRIPE_SECRET_KEY=""
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
PLATFORM_FEE_RATE="0.10"

# API
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Auth (generate secure values for production)
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SOCIAL_ENCRYPTION_KEY="generate-a-random-32-character-value"

# Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Imtiaz Mart"
# Google OAuth (customers and vendors)
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI:     http://localhost:3000/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
